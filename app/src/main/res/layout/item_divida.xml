<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    android:background="@drawable/bg_card_glass"
    android:orientation="vertical"
    android:padding="16dp">

    <!-- Linha 1: data + título/detalhe + valor/status -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <LinearLayout
            android:layout_width="52dp"
            android:layout_height="56dp"
            android:background="@drawable/bg_data_card"
            android:gravity="center"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvMesDivida"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:includeFontPadding="false"
                android:letterSpacing="0.08"
                android:text="OUT"
                android:textColor="#94A3B8"
                android:textSize="10sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvDiaDivida"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:includeFontPadding="false"
                android:text="15"
                android:textColor="#FFFFFF"
                android:textSize="20sp"
                android:textStyle="bold" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="14dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvTituloDivida"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="Fatura Nubank Roxinho"
                android:textColor="#FFFFFF"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvDetalheDivida"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="Nubank · Cartão de Crédito"
                android:textColor="#94A3B8"
                android:textSize="13sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:gravity="end"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvValorRestante"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="R$ 750,00"
                android:textColor="#FFFFFF"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvVencimento"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="Vence em 4 dias"
                android:textColor="#F59E0B"
                android:textSize="12sp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="14dp"
        android:background="#1E2A44" />

    <!-- Linha 2: parcelas -->
    <LinearLayout
        android:id="@+id/llParcelas"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tvParcela"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Parcela 2/4"
                android:textColor="#C7CEDB"
                android:textSize="13sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvProgressoParcelas"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Pagas: 1 de 4"
                android:textColor="#94A3B8"
                android:textSize="12sp" />
        </LinearLayout>

        <ProgressBar
            android:id="@+id/progressParcelas"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="6dp"
            android:layout_marginTop="8dp"
            android:progress="25"
            android:progressDrawable="@drawable/bg_progress_orcamento" />
    </LinearLayout>

    <!-- Linha 3: ações -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/btnEditar"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="@drawable/bg_icone_acao"
            android:contentDescription="Editar"
            android:foreground="?attr/selectableItemBackground"
            android:padding="11dp"
            android:src="@drawable/ic_edit"
            app:tint="#94A3B8"
            xmlns:app="http://schemas.android.com/apk/res-auto" />

        <ImageView
            android:id="@+id/btnExcluir"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_marginStart="8dp"
            android:background="@drawable/bg_icone_acao"
            android:contentDescription="Excluir"
            android:foreground="?attr/selectableItemBackground"
            android:padding="11dp"
            android:src="@drawable/ic_trash"
            app:tint="#F87171"
            xmlns:app="http://schemas.android.com/apk/res-auto" />

        <View
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <TextView
            android:id="@+id/btnPagar"
            android:layout_width="wrap_content"
            android:layout_height="44dp"
            android:background="@drawable/bg_botao_pagar"
            android:clickable="true"
            android:focusable="true"
            android:foreground="?attr/selectableItemBackground"
            android:gravity="center"
            android:minWidth="120dp"
            android:paddingHorizontal="24dp"
            android:text="Pagar"
            android:textColor="#052E22"
            android:textSize="15sp"
            android:textStyle="bold" />
    </LinearLayout>

</LinearLayout>