<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0B1220">

    <ScrollView
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:fillViewport="true"
        app:layout_constraintBottom_toTopOf="@id/bottomNavigation"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- Top Bar: Voltar -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="20dp">

                <ImageView
                    android:id="@+id/btnVoltar"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:src="?attr/homeAsUpIndicator"
                    app:tint="@color/text_white"
                    android:contentDescription="Voltar" />
            </LinearLayout>

            <!-- Título -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Criar Categoria"
                android:textColor="#FFFFFF"
                android:textSize="26sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="20dp"
                android:text="Personalize tags para organizar suas dívidas"
                android:textColor="#64748B"
                android:textSize="13sp" />

            <!-- Card: Nova Categoria -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="20dp"
                app:cardBackgroundColor="#131C2E"
                app:cardCornerRadius="16dp"
                app:cardElevation="0dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <!-- Label: Nome -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Nome da Categoria"
                        android:textColor="#94A3B8"
                        android:textSize="13sp"
                        android:layout_marginBottom="8dp" />

                    <EditText
                        android:id="@+id/editNomeCategoria"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:background="@drawable/bg_campo_login"
                        android:hint="Ex: Faculdade e Cursos"
                        android:textColor="#FFFFFF"
                        android:textColorHint="#64748B"
                        android:paddingHorizontal="12dp"
                        android:inputType="text"
                        android:layout_marginBottom="16dp" />

                    <!-- Label: Cor -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Cor de Identificação"
                        android:textColor="#94A3B8"
                        android:textSize="13sp"
                        android:layout_marginBottom="8dp" />

                    <!-- Paleta de cores -->
                    <LinearLayout
                        android:id="@+id/containerCores"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginBottom="16dp" />

                    <!-- Prévia da Tag -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Prévia da Tag"
                        android:textColor="#94A3B8"
                        android:textSize="13sp"
                        android:layout_marginBottom="8dp" />

                    <TextView
                        android:id="@+id/tvPreviaTag"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_campo_login"
                        android:paddingHorizontal="16dp"
                        android:paddingVertical="8dp"
                        android:text="Faculdade e Cursos"
                        android:textColor="#FFFFFF"
                        android:textSize="14sp"
                        android:drawablePadding="8dp"
                        android:layout_marginBottom="20dp" />

                    <!-- Botão Salvar -->
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnSalvarCategoria"
                        android:layout_width="match_parent"
                        android:layout_height="52dp"
                        android:backgroundTint="#10B981"
                        android:text="+ Salvar e Usar no Lançamento"
                        android:textAllCaps="false"
                        android:textColor="#000000"
                        android:textSize="15sp"
                        android:textStyle="bold"
                        app:cornerRadius="12dp" />
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- Título: Categorias ativas -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="CATEGORIAS ATIVAS NO APP"
                android:textColor="#64748B"
                android:textSize="12sp"
                android:textStyle="bold"
                android:layout_marginBottom="12dp" />

            <!-- Lista de categorias -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardBackgroundColor="#131C2E"
                app:cardCornerRadius="16dp"
                app:cardElevation="0dp">

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rvCategorias"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:padding="8dp" />
            </androidx.cardview.widget.CardView>

        </LinearLayout>
    </ScrollView>

    <!-- Bottom Navigation -->
    <LinearLayout
        android:id="@+id/bottomNavigation"
        android:layout_width="match_parent"
        android:layout_height="72dp"
        android:background="#0B1220"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <TextView
            android:id="@+id/tabInicio"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:text="⌂\nInício"
            android:textColor="#64748B"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/tabLancar"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:text="+\nLançar"
            android:textColor="#64748B"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/tabDividas"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:text="⊡\nDívidas"
            android:textColor="#64748B"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/tabRelatorios"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:text="◷\nRelatórios"
            android:textColor="#64748B"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/tabConfig"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:text="⚙\nConfig"
            android:textColor="#64748B"
            android:textSize="12sp" />

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>