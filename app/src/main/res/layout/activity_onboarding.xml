<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_gradient_inicio">

    <LinearLayout
        android:id="@+id/headerOnboarding"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="12dp"
        android:paddingTop="28dp"
        app:layout_constraintTop_toTopOf="parent">

        <ImageView
            android:id="@+id/btnVoltarOnb"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Voltar"
            android:padding="10dp"
            android:src="@drawable/ic_chevron_left"
            android:visibility="invisible"
            app:tint="#94A3B8" />

        <LinearLayout
            android:id="@+id/llProgressOnb"
            android:layout_width="0dp"
            android:layout_height="4dp"
            android:layout_marginHorizontal="12dp"
            android:layout_weight="1"
            android:orientation="horizontal" />

        <TextView
            android:id="@+id/tvPassoOnb"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="8dp"
            android:minWidth="72dp"
            android:gravity="end"
            android:text="Passo 1 de 3"
            android:textColor="#94A3B8"
            android:textSize="13sp" />
    </LinearLayout>

    <ViewFlipper
        android:id="@+id/viewFlipperOnboarding"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="12dp"
        app:layout_constraintBottom_toTopOf="@+id/bottomContainer"
        app:layout_constraintTop_toBottomOf="@+id/headerOnboarding" />

    <FrameLayout
        android:id="@+id/bottomContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingHorizontal="20dp"
        android:paddingTop="8dp"
        android:paddingBottom="28dp"
        app:layout_constraintBottom_toBottomOf="parent">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnAvancarOnb"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:backgroundTint="#10B981"
            android:text="Continuar"
            android:textAllCaps="false"
            android:textColor="#052E22"
            android:textSize="16sp"
            android:textStyle="bold"
            app:cornerRadius="18dp" />
    </FrameLayout>

</androidx.constraintlayout.widget.ConstraintLayout>