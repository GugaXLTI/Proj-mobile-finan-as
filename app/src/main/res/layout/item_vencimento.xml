<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:paddingVertical="12dp"
    android:paddingHorizontal="8dp">

    <!-- ⭐ Quadrado da Data -->
    <LinearLayout
        android:id="@+id/layoutData"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:background="@drawable/bg_data_card"
        android:orientation="vertical"
        android:gravity="center">

        <TextView
            android:id="@+id/tvMesVencimento"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="OUT"
            android:textColor="#EF4444"
            android:textSize="10sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvDiaVencimento"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="28"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Título e Detalhes -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical"
        android:layout_marginStart="16dp">

        <TextView
            android:id="@+id/tvTituloVencimento"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Fatura Nubank"
            android:textColor="#FFFFFF"
            android:textSize="15sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvDetalheVencimento"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="Vence em 4 dias"
            android:textColor="#F59E0B"
            android:textSize="12sp" />

        <!-- Oculto por padrão, mas mantido para a lógica de parcelas -->
        <TextView
            android:id="@+id/tvParcelaVencimento"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Parcela 2 de 4"
            android:textColor="#10B981"
            android:textSize="11sp"
            android:textStyle="bold"
            android:visibility="gone" />
    </LinearLayout>

    <!-- Valor -->
    <TextView
        android:id="@+id/tvValorVencimento"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="R$ 420,00"
        android:textColor="#FFFFFF"
        android:textSize="16sp"
        android:textStyle="bold" />

    <!-- Oculto por padrão -->
    <TextView
        android:id="@+id/tvTotalVencimento"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Total: R$ 2.450,00"
        android:textColor="#64748B"
        android:textSize="10sp"
        android:visibility="gone" />

</LinearLayout>