<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="10dp"
    android:background="@drawable/bg_item_lancamento"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:padding="12dp">

    <!-- Bolinha colorida (a cor é aplicada pelo CategoriaAdapter) -->
    <LinearLayout
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:background="@drawable/bg_data_card"
        android:gravity="center"
        android:orientation="vertical">

        <View
            android:id="@+id/viewCorCategoria"
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:background="@drawable/bg_circulo_cor" />
    </LinearLayout>

    <!-- Nome + contagem -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="14dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tvNomeCategoria"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvContagemCategoria"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:textColor="#94A3B8"
            android:textSize="13sp" />
    </LinearLayout>

    <!-- Excluir -->
    <ImageView
        android:id="@+id/btnExcluirCategoria"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:layout_marginStart="8dp"
        android:background="@drawable/bg_icone_acao"
        android:contentDescription="Excluir categoria"
        android:padding="12dp"
        android:src="@drawable/ic_trash"
        app:tint="#F87171" />

</LinearLayout>