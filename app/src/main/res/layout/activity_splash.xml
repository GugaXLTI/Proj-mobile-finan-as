<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/fundo_escuro"
    android:padding="32dp">

    <!-- LOGO -->
    <ImageView
        android:id="@+id/ivLogoSplash"
        android:layout_width="120dp"
        android:layout_height="120dp"
        android:src="@drawable/logo"
        android:contentDescription="Logo do app"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toTopOf="@+id/tvTituloSplash"
        app:layout_constraintVertical_chainStyle="packed" />

    <!-- TÍTULO -->
    <TextView
        android:id="@+id/tvTituloSplash"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="O caminho simples"
        android:fontFamily="@font/abril_fatface"
        android:textSize="28sp"
        android:textStyle="bold"
        android:textColor="#FFFFFF"
        android:letterSpacing="0.05"
        android:shadowColor="#000000"
        android:shadowDx="0"
        android:shadowDy="2"
        android:shadowRadius="4"
        android:textAlignment="center"
        android:layout_marginTop="16dp"
        app:layout_constraintTop_toBottomOf="@+id/ivLogoSplash"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toTopOf="@+id/tvSubtituloSplash" />

    <!-- SUBTÍTULO -->
    <TextView
        android:id="@+id/tvSubtituloSplash"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="para controlar suas dívidas."
        android:fontFamily="@font/abril_fatface"
        android:textSize="16sp"
        android:textColor="#94A3B8"
        android:letterSpacing="0.02"
        android:textAlignment="center"
        android:layout_marginTop="8dp"
        app:layout_constraintTop_toBottomOf="@+id/tvTituloSplash"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toBottomOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>