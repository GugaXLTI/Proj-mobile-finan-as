<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_screen"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Tipo de Chave Pix"
            android:textColor="@color/text_gray"
            android:textSize="12sp" />
        <Spinner
            android:id="@+id/spinnerTipoChave"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:background="@drawable/bg_form_field"
            android:layout_marginBottom="16dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Chave Pix do Credor"
            android:textColor="@color/text_gray"
            android:textSize="12sp" />
        <EditText
            android:id="@+id/etChavePix"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:background="@drawable/bg_form_field"
            android:layout_marginBottom="16dp"
            android:hint="Ex: 42.123.456/0001-89"
            android:textColorHint="@color/text_hint"
            android:textColor="@color/text_white"
            android:paddingStart="12dp"
            android:paddingEnd="12dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Nome do Favorecido"
            android:textColor="@color/text_gray"
            android:textSize="12sp" />
        <EditText
            android:id="@+id/etNomeFavorecido"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:background="@drawable/bg_form_field"
            android:layout_marginBottom="24dp"
            android:hint="Ex: Mecânica Silva"
            android:textColorHint="@color/text_hint"
            android:textColor="@color/text_white"
            android:paddingStart="12dp"
            android:paddingEnd="12dp" />

        <Button
            android:id="@+id/btnCadastrarPix"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:text="+ Cadastrar Chave Pix para Dívidas"
            android:background="@drawable/bg_button_green"
            android:textColor="@color/black"
            android:textStyle="bold"
            android:layout_marginBottom="8dp" />

        <!-- ⭐ NOVO: Botão Cancelar Edição (escondido por padrão) -->
        <Button
            android:id="@+id/btnCancelarEdicaoPix"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:text="✕ Cancelar edição"
            android:background="#2A3A5A"
            android:textColor="@color/text_white"
            android:textStyle="bold"
            android:layout_marginBottom="24dp"
            android:visibility="gone" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="CHAVES DE CREDORES SALVAS"
            android:textColor="@color/text_gray"
            android:textSize="12sp"
            android:textStyle="bold"
            android:layout_marginBottom="8dp" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvChavesPix"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />
    </LinearLayout>
</androidx.core.widget.NestedScrollView>