<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="10dp"
    app:cardBackgroundColor="@color/card_bg"
    app:cardCornerRadius="12dp"
    app:cardElevation="0dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="14dp"
        android:gravity="center_vertical">

        <!-- ⭐ ÍCONE DE ESTADO (muda conforme o estado) -->
        <TextView
            android:id="@+id/tvIconeEstado"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:gravity="center"
            android:text="✓"
            android:textSize="18sp"
            android:textStyle="bold"
            android:background="@drawable/bg_icone_estado" />

        <!-- Informações -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:layout_marginStart="12dp">

            <TextView
                android:id="@+id/tvTituloHistorico"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Ingressos Show Ghost"
                android:textColor="@color/text_white"
                android:textSize="14sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvDetalheHistorico"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Pago via Nubank • 14/09"
                android:textColor="@color/text_gray"
                android:textSize="11sp"
                android:layout_marginTop="2dp" />
        </LinearLayout>

        <!-- Valor + Badge de Status -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="end">

            <TextView
                android:id="@+id/tvValorHistorico"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="R$ 280,00"
                android:textColor="@color/brand_green"
                android:textSize="14sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvStatusHistorico"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Liquidado ✓"
                android:textColor="@color/brand_green"
                android:textSize="10sp"
                android:textStyle="bold"
                android:background="@drawable/bg_badge_verde"
                android:paddingHorizontal="8dp"
                android:paddingVertical="3dp"
                android:layout_marginTop="4dp" />
        </LinearLayout>
    </LinearLayout>
</androidx.cardview.widget.CardView>