<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="10dp"
    app:cardBackgroundColor="#151E31"
    app:cardCornerRadius="12dp"
    app:cardElevation="0dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="14dp"
        android:gravity="center_vertical">

        <!-- Ícone de Transação Automática -->
        <TextView
            android:id="@+id/tvIconeTransacao"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:gravity="center"
            android:text="⚡"
            android:textSize="18sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:layout_marginStart="12dp">

            <TextView
                android:id="@+id/tvTituloTransacao"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Mercado Central"
                android:textColor="#FFFFFF"
                android:textSize="14sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvDetalheTransacao"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Automático • Alimentação • 14/09/2026"
                android:textColor="#94A3B8"
                android:textSize="11sp"
                android:layout_marginTop="2dp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="end">

            <TextView
                android:id="@+id/tvValorTransacao"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="- R$ 50,00"
                android:textColor="#F87171"
                android:textSize="14sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvStatusTransacao"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Saída"
                android:textColor="#F87171"
                android:textSize="10sp"
                android:textStyle="bold"
                android:background="@drawable/bg_badge_aberto"
                android:paddingHorizontal="8dp"
                android:paddingVertical="3dp"
                android:layout_marginTop="4dp" />
        </LinearLayout>
    </LinearLayout>
</androidx.cardview.widget.CardView>