<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- FORMULÁRIO DE CADASTRO -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Tipo de Chave Pix"
            android:textColor="@color/text_gray" />
        <Spinner
            android:id="@+id/spinnerTipoChave"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:background="@drawable/bg_campo_login"
            android:layout_marginBottom="12dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Chave Pix do Credor"
            android:textColor="@color/text_gray" />
        <EditText
            android:id="@+id/etChavePix"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:background="@drawable/bg_campo_login"
            android:layout_marginBottom="12dp"
            android:hint="Ex: 42.123.456/0001-89"
            android:textColorHint="@color/text_hint"
            android:textColor="@color/text_white" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Nome do Favorecido"
            android:textColor="@color/text_gray" />
        <EditText
            android:id="@+id/etNomeFavorecido"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:background="@drawable/bg_campo_login"
            android:layout_marginBottom="12dp"
            android:hint="Ex: Mecânica Silva"
            android:textColorHint="@color/text_hint"
            android:textColor="@color/text_white" />

        <Button
            android:id="@+id/btnCadastrarPix"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="+ Cadastrar Chave Pix para Dívidas"
            android:backgroundTint="@color/brand_green"
            android:textColor="@color/black"
            android:layout_marginBottom="24dp" />

        <!-- LISTA DE CHAVES -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="CHAVES DE CREDORES SALVAS"
            android:textColor="@color/text_gray"
            android:textSize="12sp"
            android:layout_marginBottom="8dp" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvChavesPix"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />
    </LinearLayout>
</androidx.core.widget.NestedScrollView>